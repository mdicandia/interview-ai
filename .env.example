# Copy to .env.local and fill in. Never commit .env.local.

# https://platform.deepseek.com — the interviewer LLM
DEEPSEEK_API_KEY=

# https://console.deepgram.com — streaming speech-to-text.
# Billed per minute of audio *streamed*, not per minute spoken: an open
# microphone costs the same whether you are talking or typing in silence.
DEEPGRAM_API_KEY=

# The interviewer's voice. Defaults to "kokoro" — a local model, no key, no
# per-character cost. Set to "cartesia" for the hosted voice, which reaches first
# audio ~500ms sooner and bills roughly one credit per character.
TTS_PROVIDER=kokoro

# Which local voice. `bm_*` British male, `am_*` American male, `af_*`/`bf_*`
# female. After changing this, regenerate the backchannel clips — otherwise the
# "mm-hm" is a different person from the interviewer:
#   pnpm gen:backchannels
KOKORO_VOICE=bm_george

# https://play.cartesia.ai — only read when TTS_PROVIDER=cartesia
CARTESIA_API_KEY=

VOICE_SERVER_PORT=8787
NEXT_PUBLIC_VOICE_SERVER_URL=ws://localhost:8787
